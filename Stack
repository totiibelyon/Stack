#include <stdio.h>
#define MAX 5
int stack[MAX];
int top = -1;

void push(int x){
  if(top == MAX-1){
    printf("Stack is Full!!\n");
  } else {
    top++;
    stack[top] = x;
    printf("%d pushed\n", x);
  }
}
void pop(){
  if(top == -1){
    printf("Stack is Empty!!\n");
  } else {
    printf("%d popped\n", stack[top]);
    top--;
  }
}

void display(){
  if(top == -1){
    printf("Stack empty\n");
  } else {
    for(int i=top; i>=0; i--){
      printf("%d\n", stack[i]);
    }
  }
}
